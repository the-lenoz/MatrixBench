if(NOT DEFINED CLI OR NOT DEFINED CASE OR NOT DEFINED TEST_ID)
    message(FATAL_ERROR "CLI, CASE, and TEST_ID are required")
endif()

# Helpers contain iteration; each scenario keeps preparation, execution and
# validation separate. These are functions, never CMake macros.
function(require_fragments text)
    foreach(fragment IN LISTS ARGN)
        string(FIND "${text}" "${fragment}" position)
        if(position EQUAL -1)
            message(FATAL_ERROR "Missing ${fragment}: [${text}]")
        endif()
    endforeach()
endfunction()

function(make_triangular_input size result)
    set(input "${size}\n")
    math(EXPR last_index "${size} - 1")
    foreach(row RANGE 0 ${last_index})
        math(EXPR superdiagonal "${row} + 1")
        foreach(column RANGE 0 ${last_index})
            if(column EQUAL row OR column EQUAL superdiagonal)
                string(APPEND input "1 ")
            else()
                string(APPEND input "0 ")
            endif()
        endforeach()
        string(APPEND input "\n")
    endforeach()
    set(${result} "${input}" PARENT_SCOPE)
endfunction()

if(CASE STREQUAL "bench_smoke" OR CASE STREQUAL "bench_list")
    # Arrange
    set(directory "${CMAKE_CURRENT_BINARY_DIR}/matrixbench-${CASE}")
    file(REMOVE_RECURSE "${directory}")
    if(CASE STREQUAL "bench_list")
        # Act
        execute_process(COMMAND "${CLI}" --output "${directory}" --benchmark_list_tests
            RESULT_VARIABLE result OUTPUT_VARIABLE names ERROR_VARIABLE errors TIMEOUT 10)
        # Assert
        if(NOT result EQUAL 0 OR EXISTS "${directory}" OR NOT names MATCHES "determinant/gauss/contiguous")
            message(FATAL_ERROR "List failed: ${result} ${names} ${errors}")
        endif()
    else()
        # Act
        execute_process(COMMAND "${CLI}" --output "${directory}" --benchmark_min_time=1x --benchmark_repetitions=2 --benchmark_display_aggregates_only=true
            RESULT_VARIABLE result OUTPUT_VARIABLE names ERROR_VARIABLE errors TIMEOUT 60)
        # Assert
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Smoke failed: ${result} ${errors}")
        endif()
        file(READ "${directory}/core_results.json" data)
        string(JSON count LENGTH "${data}" benchmarks)
        # 88 cases * (2 repetitions + mean/median/stddev/cv).
        if(NOT count EQUAL 528)
            message(FATAL_ERROR "Unexpected result count: ${count}")
        endif()
        require_fragments("${data}" "construct/storage/jagged" "fill_row_major/storage/contiguous"
            "copy/storage/jagged" "determinant/bareiss/jagged" "determinant/gauss/contiguous")
    endif()
    return()
endif()

# Arrange
set(arguments)
set(input "")
set(expected_exit 0)
set(expected_stdout "")
set(expected_stderr "")
set(error_prefix "matrixbench:")
set(expect_help FALSE)

if(CASE MATCHES "^bench_")
    set(error_prefix "matrixbench_bench:")
    set(expected_exit 2)
    set(output_directory "${CMAKE_CURRENT_BINARY_DIR}/matrixbench-e2e-${TEST_ID}-output")
    if(EXISTS "${output_directory}")
        message(FATAL_ERROR "Test output path already exists: ${output_directory}")
    endif()
    set(arguments --output "${output_directory}")
    if(CASE STREQUAL "bench_help")
        set(arguments --help)
        set(expected_exit 0)
        set(expect_help TRUE)
    elseif(CASE STREQUAL "bench_google_time")
        list(APPEND arguments --benchmark_min_time=bad)
    elseif(CASE STREQUAL "bench_google_unknown")
        list(APPEND arguments --benchmark_unknown=1)
    elseif(CASE STREQUAL "bench_google_invalid")
        list(APPEND arguments --benchmark_repetitions=bad)
    elseif(CASE STREQUAL "bench_no_args")
        set(arguments)
    elseif(CASE STREQUAL "bench_missing_output")
        set(arguments --mode quick)
    elseif(CASE STREQUAL "bench_empty_output")
        set(arguments --output)
        set(append_empty_argument TRUE)
    elseif(CASE MATCHES "^bench_missing_(output|mode|filter|seed)_value$")
        set(arguments --output "${output_directory}" "--${CMAKE_MATCH_1}")
    elseif(CASE MATCHES "^bench_duplicate_(output|mode|filter|seed)$")
        set(option "${CMAKE_MATCH_1}")
        if(option STREQUAL "output")
            set(value "${output_directory}")
        elseif(option STREQUAL "mode")
            set(value quick)
        elseif(option STREQUAL "filter")
            set(value all)
        else()
            set(value 1)
        endif()
        set(arguments --output "${output_directory}" "--${option}" "${value}" "--${option}" "${value}")
    elseif(CASE STREQUAL "bench_invalid_mode")
        list(APPEND arguments --mode fast)
    elseif(CASE STREQUAL "bench_invalid_filter")
        list(APPEND arguments --filter gaussian)
    elseif(CASE STREQUAL "bench_negative_seed")
        list(APPEND arguments --seed -1)
    elseif(CASE STREQUAL "bench_overflow_seed")
        list(APPEND arguments --seed 18446744073709551616)
    elseif(CASE STREQUAL "bench_fractional_seed")
        list(APPEND arguments --seed 1.5)
    elseif(CASE STREQUAL "bench_malformed_seed")
        list(APPEND arguments --seed 12x)
    elseif(CASE STREQUAL "bench_signed_seed")
        list(APPEND arguments --seed +1)
    elseif(CASE STREQUAL "bench_empty_seed")
        list(APPEND arguments --seed)
        set(append_empty_argument TRUE)
    elseif(CASE STREQUAL "bench_unknown_flag")
        list(APPEND arguments --verbose)
    elseif(CASE STREQUAL "bench_extra_argument")
        list(APPEND arguments extra)
    elseif(CASE STREQUAL "bench_short_help")
        set(arguments -h)
    elseif(CASE STREQUAL "bench_help_first")
        list(PREPEND arguments --help)
    elseif(CASE STREQUAL "bench_help_last")
        list(APPEND arguments --help)
    elseif(CASE STREQUAL "bench_equals")
        set(arguments "--output=${output_directory}")
    elseif(CASE STREQUAL "bench_terminator")
        list(APPEND arguments --)
    elseif(CASE MATCHES "^bench_seed_(zero|max)$")
        # A blocked destination proves parsing succeeded without running a benchmark.
        set(blocked_path "${output_directory}.blocked-path")
        file(WRITE "${blocked_path}" "block directory creation")
        if(CMAKE_MATCH_1 STREQUAL "zero")
            set(arguments --seed 0 --output "${blocked_path}/child")
        else()
            set(arguments --filter bareiss --seed 18446744073709551615 --mode full --output "${blocked_path}/child")
        endif()
        set(expected_stderr "${blocked_path}")
    else()
        message(FATAL_ERROR "Unknown benchmark E2E case: ${CASE}")
    endif()
elseif(CASE STREQUAL "identity")
    set(arguments --storage "${STORAGE}" --algorithm "${ALGORITHM}")
    set(input "2 1 0 0 1\n")
    set(expected_stdout "1\n")
elseif(CASE STREQUAL "known")
    set(arguments --storage "${STORAGE}" --algorithm "${ALGORITHM}")
    set(input "3 2 5 3 1 -2 -1 1 3 4\n")
    set(expected_stdout "-20\n")
elseif(CASE STREQUAL "fractional")
    set(arguments --storage "${STORAGE}" --algorithm gauss)
    set(input "2 0.5 0 0 2\n")
    set(expected_stdout "1\n")
elseif(CASE STREQUAL "zero")
    set(arguments --storage "${STORAGE}" --algorithm "${ALGORITHM}")
    set(input "0\n")
    set(expected_stdout "1\n")
elseif(CASE STREQUAL "large")
    set(arguments --storage "${STORAGE}" --algorithm "${ALGORITHM}")
    make_triangular_input(128 input)
    set(expected_stdout "1\n")
elseif(CASE STREQUAL "reverse_order")
    set(arguments --algorithm gauss --storage jagged)
    set(input "2 1 2 3 4\n")
    set(expected_stdout "-2\n")
elseif(CASE STREQUAL "help")
    set(arguments --help)
    set(expect_help TRUE)
elseif(CASE STREQUAL "missing_storage")
    set(arguments --algorithm gauss)
    set(expected_exit 2)
    set(expected_stderr "--storage")
elseif(CASE STREQUAL "missing_algorithm")
    set(arguments --storage contiguous)
    set(expected_exit 2)
    set(expected_stderr "--algorithm")
elseif(CASE STREQUAL "unknown_storage")
    set(arguments --storage flat --algorithm gauss)
    set(expected_exit 2)
    set(expected_stderr "--storage")
elseif(CASE STREQUAL "unknown_algorithm")
    set(arguments --storage contiguous --algorithm laplace)
    set(expected_exit 2)
    set(expected_stderr "--algorithm")
elseif(CASE STREQUAL "duplicate_storage")
    set(arguments --storage contiguous --storage jagged --algorithm gauss)
    set(expected_exit 2)
    set(expected_stderr "--storage")
elseif(CASE STREQUAL "unknown_flag")
    set(arguments --storage contiguous --algorithm gauss --verbose)
    set(expected_exit 2)
    set(expected_stderr "--verbose")
elseif(CASE STREQUAL "extra_argument")
    set(arguments --storage contiguous --algorithm gauss extra)
    set(expected_exit 2)
    set(expected_stderr "extra")
elseif(CASE STREQUAL "duplicate_algorithm")
    set(arguments --storage contiguous --algorithm gauss --algorithm bareiss)
    set(expected_exit 2)
elseif(CASE STREQUAL "duplicate_same")
