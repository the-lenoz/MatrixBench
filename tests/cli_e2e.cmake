    set(append_empty_argument TRUE)
    set(expected_exit 2)
elseif(CASE STREQUAL "empty_algorithm")
    set(arguments --storage contiguous --algorithm)
    set(append_empty_argument TRUE)
    set(expected_exit 2)
elseif(CASE STREQUAL "help_first")
