if(NOT DEFINED CLI OR NOT DEFINED CASE OR NOT DEFINED TEST_ID)
    message(FATAL_ERROR "CLI, CASE, and TEST_ID are required")
endif()

set(arguments)
set(input "")
set(expected_exit 0)
set(expected_stdout "")
set(expected_stderr "")

if(CASE STREQUAL "identity")
    set(arguments --storage "${STORAGE}" --algorithm "${ALGORITHM}")
    set(input "2 1 0 0 1\n")
    set(expected_stdout "1\n")
elseif(CASE STREQUAL "known")
    set(arguments --storage "${STORAGE}" --algorithm "${ALGORITHM}")
    set(input "3 2 5 3 1 -2 -1 1 3 4\n")
    set(expected_stdout "-20\n")
elseif(CASE STREQUAL "fractional")
    set(arguments --storage "${STORAGE}" --algorithm gauss)
    set(input "2 0.5 0 0 2\n")
    set(expected_stdout "1\n")
elseif(CASE STREQUAL "zero")
    set(arguments --storage "${STORAGE}" --algorithm "${ALGORITHM}")
    set(input "0\n")
    set(expected_stdout "1\n")
elseif(CASE STREQUAL "large")
    set(arguments --storage "${STORAGE}" --algorithm "${ALGORITHM}")
    set(matrix_size 128)
    set(input "${matrix_size}\n")
    math(EXPR last_index "${matrix_size} - 1")
    foreach(row RANGE 0 ${last_index})
        math(EXPR superdiagonal "${row} + 1")
        foreach(column RANGE 0 ${last_index})
            if(column EQUAL row OR column EQUAL superdiagonal)
                string(APPEND input "1 ")
            else()
                string(APPEND input "0 ")
            endif()
        endforeach()
        string(APPEND input "\n")
    endforeach()
    set(expected_stdout "1\n")
elseif(CASE STREQUAL "reverse_order")
    set(arguments --algorithm gauss --storage jagged)
    set(input "2 1 2 3 4\n")
    set(expected_stdout "-2\n")
elseif(CASE STREQUAL "help")
    set(arguments --help)
    set(expected_stdout
        "Usage: matrixbench --storage <contiguous|jagged> --algorithm <gauss|bareiss>\nReads N followed by exactly N*N matrix elements from standard input.\ngauss reads double; bareiss reads long long.\n"
    )
elseif(CASE STREQUAL "missing_storage")
    set(arguments --algorithm gauss)
    set(expected_exit 2)
    set(expected_stderr "missing required --storage")
elseif(CASE STREQUAL "missing_algorithm")
    set(arguments --storage contiguous)
    set(expected_exit 2)
    set(expected_stderr "missing required --algorithm")
elseif(CASE STREQUAL "unknown_storage")
    set(arguments --storage flat --algorithm gauss)
    set(expected_exit 2)
    set(expected_stderr "unknown storage")
elseif(CASE STREQUAL "unknown_algorithm")
    set(arguments --storage contiguous --algorithm laplace)
    set(expected_exit 2)
    set(expected_stderr "unknown algorithm")
elseif(CASE STREQUAL "duplicate_storage")
    set(arguments --storage contiguous --storage jagged --algorithm gauss)
    set(expected_exit 2)
    set(expected_stderr "duplicate --storage")
elseif(CASE STREQUAL "unknown_flag")
    set(arguments --storage contiguous --algorithm gauss --verbose)
    set(expected_exit 2)
    set(expected_stderr "unknown argument")
elseif(CASE STREQUAL "extra_argument")
    set(arguments --storage contiguous --algorithm gauss extra)
    set(expected_exit 2)
    set(expected_stderr "unknown argument")
elseif(CASE STREQUAL "negative_size")
    set(arguments --storage contiguous --algorithm gauss)
    set(input "-1\n")
    set(expected_exit 3)
    set(expected_stderr "matrix size must be nonnegative")
elseif(CASE STREQUAL "unreadable_size")
    set(arguments --storage contiguous --algorithm gauss)
    set(input "size\n")
    set(expected_exit 3)
    set(expected_stderr "failed to read matrix size")
elseif(CASE STREQUAL "missing_elements")
    set(arguments --storage contiguous --algorithm gauss)
    set(input "2 1 0 0\n")
    set(expected_exit 3)
    set(expected_stderr "failed to read matrix element")
elseif(CASE STREQUAL "trailing_token")
    set(arguments --storage contiguous --algorithm gauss)
    set(input "1 1 extra\n")
    set(expected_exit 3)
    set(expected_stderr "unexpected trailing input")
elseif(CASE STREQUAL "fractional_bareiss")
    set(arguments --storage contiguous --algorithm bareiss)
    set(input "1 1.5\n")
    set(expected_exit 3)
    set(expected_stderr "unexpected trailing input")
elseif(CASE STREQUAL "bareiss_overflow")
    set(arguments --storage contiguous --algorithm bareiss)
    set(input "2 9223372036854775807 0 0 2\n")
    set(expected_exit 4)
    set(expected_stderr "integer multiplication overflow")
else()
    message(FATAL_ERROR "Unknown E2E case: ${CASE}")
endif()

set(input_file "${CMAKE_CURRENT_BINARY_DIR}/matrixbench-e2e-${TEST_ID}.txt")
file(WRITE "${input_file}" "${input}")

execute_process(
    COMMAND "${CLI}" ${arguments}
    INPUT_FILE "${input_file}"
    OUTPUT_VARIABLE actual_stdout
    ERROR_VARIABLE actual_stderr
    RESULT_VARIABLE actual_exit
)

file(REMOVE "${input_file}")

if(NOT actual_exit EQUAL expected_exit)
    message(FATAL_ERROR
        "Expected exit ${expected_exit}, got ${actual_exit}.\n"
        "stdout: [${actual_stdout}]\n"
        "stderr: [${actual_stderr}]"
    )
endif()

if(NOT actual_stdout STREQUAL expected_stdout)
    message(FATAL_ERROR
        "Unexpected stdout.\nExpected: [${expected_stdout}]\n"
        "Actual: [${actual_stdout}]"
    )
endif()

if(expected_stderr STREQUAL "")
    if(NOT actual_stderr STREQUAL "")
        message(FATAL_ERROR "Expected empty stderr, got: [${actual_stderr}]")
    endif()
else()
    string(FIND "${actual_stderr}" "matrixbench: ${expected_stderr}" error_position)
    if(error_position EQUAL -1)
        message(FATAL_ERROR
            "stderr does not contain expected diagnostic.\n"
            "Expected fragment: [matrixbench: ${expected_stderr}]\n"
            "Actual: [${actual_stderr}]"
        )
    endif()
endif()
