elseif(CASE STREQUAL "help_last")
    set(arguments --storage contiguous --algorithm gauss --help)
    set(expected_exit 2)
elseif(CASE STREQUAL "help_unknown")
    set(arguments --help --unknown)
    set(expected_exit 2)
elseif(CASE STREQUAL "short_help")
    set(arguments -h)
    set(expected_exit 2)
elseif(CASE STREQUAL "equals")
    set(arguments --storage=contiguous --algorithm=gauss)
    set(expected_exit 2)
elseif(CASE STREQUAL "terminator")
    set(arguments --storage contiguous --algorithm gauss --)
    set(expected_exit 2)
elseif(CASE STREQUAL "no_args")
    set(expected_exit 2)
elseif(CASE STREQUAL "negative_size")
    set(arguments --storage contiguous --algorithm gauss)
    set(input "-1\n")
    set(expected_exit 3)
    set(expected_stderr "matrix size must be nonnegative")
elseif(CASE STREQUAL "unreadable_size")
    set(arguments --storage contiguous --algorithm gauss)
    set(input "size\n")
    set(expected_exit 3)
    set(expected_stderr "failed to read matrix size")
elseif(CASE STREQUAL "missing_elements")
    set(arguments --storage contiguous --algorithm gauss)
    set(input "2 1 0 0\n")
    set(expected_exit 3)
    set(expected_stderr "failed to read matrix element")
elseif(CASE STREQUAL "trailing_token")
    set(arguments --storage contiguous --algorithm gauss)
    set(input "1 1 extra\n")
    set(expected_exit 3)
    set(expected_stderr "unexpected trailing input")
elseif(CASE STREQUAL "fractional_bareiss")
    set(arguments --storage contiguous --algorithm bareiss)
    set(input "1 1.5\n")
    set(expected_exit 3)
    set(expected_stderr "unexpected trailing input")
elseif(CASE STREQUAL "bareiss_overflow")
    set(arguments --storage contiguous --algorithm bareiss)
    set(input "2 9223372036854775807 0 0 2\n")
    set(expected_exit 4)
    set(expected_stderr "integer multiplication overflow")
else()
    message(FATAL_ERROR "Unknown E2E case: ${CASE}")
endif()

set(input_file "${CMAKE_CURRENT_BINARY_DIR}/matrixbench-e2e-${TEST_ID}.txt")
file(WRITE "${input_file}" "${input}")

if(CASE STREQUAL "bench_help")
    set(help_options --output --mode --filter --seed --benchmark_filter)
else()
    set(help_options --storage --algorithm)
endif()

# Act
if(append_empty_argument)
    # Expanding a CMake list drops empty items, so pass the empty argv value
    # explicitly to distinguish it from a missing option value.
    execute_process(
        COMMAND "${CLI}" ${arguments} ""
        INPUT_FILE "${input_file}"
        OUTPUT_VARIABLE actual_stdout
        ERROR_VARIABLE actual_stderr
        RESULT_VARIABLE actual_exit
        TIMEOUT 10
    )
else()
    execute_process(
        COMMAND "${CLI}" ${arguments}
        INPUT_FILE "${input_file}"
        OUTPUT_VARIABLE actual_stdout
        ERROR_VARIABLE actual_stderr
        RESULT_VARIABLE actual_exit
        TIMEOUT 10
    )
endif()

# Assert
if(DEFINED output_directory AND EXISTS "${output_directory}")
    message(FATAL_ERROR "Argument parsing created benchmark output: ${output_directory}")
endif()

if(NOT actual_exit EQUAL expected_exit)
    message(FATAL_ERROR
        "Expected exit ${expected_exit}, got ${actual_exit}.\n"
        "stdout: [${actual_stdout}]\n"
        "stderr: [${actual_stderr}]"
    )
endif()

if(expect_help)
    require_fragments("${actual_stdout}" "[OPTIONS]" "--help" ${help_options})
elseif(NOT actual_stdout STREQUAL expected_stdout)
    message(FATAL_ERROR
        "Unexpected stdout.\nExpected: [${expected_stdout}]\n"
        "Actual: [${actual_stdout}]"
    )
endif()

if(expected_exit EQUAL 0)
    if(NOT actual_stderr STREQUAL "")
        message(FATAL_ERROR "Expected empty stderr, got: [${actual_stderr}]")
    endif()
else()
    string(FIND "${actual_stderr}" "${error_prefix} " error_position)
    if(NOT error_position EQUAL 0)
        message(FATAL_ERROR "Expected ${error_prefix} diagnostic, got: [${actual_stderr}]")
    endif()
    if(NOT expected_stderr STREQUAL "")
        string(FIND "${actual_stderr}" "${expected_stderr}" error_position)
        if(error_position EQUAL -1)
            message(FATAL_ERROR "Missing diagnostic fragment ${expected_stderr}: [${actual_stderr}]")
        endif()
    endif()
endif()

# Cleanup
file(REMOVE "${input_file}")
if(DEFINED blocked_path)
    file(REMOVE "${blocked_path}")
endif()
